
# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/pollyfort

# Session Configuration
SESSION_SECRET=your_very_secure_session_secret_here_change_this_in_production

# Server Configuration
NODE_ENV=development
PORT=3000

# Email Configuration (optional - if not set, emails will be logged to console)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# SendGrid Configuration (alternative to SMTP)
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Optional Analytics
GTM_ID=your_google_tag_manager_id
META_PIXEL_ID=your_meta_pixel_id

# Optional External Services
OPENAI_API_KEY=your_openai_api_key_for_ai_features
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
